{
  "manifest_version": 3,
  "name": "Select & Highlight",
  "version": "0.0.2",
  "description": "Create a shareable link that highlights the selected text.",
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "host_permissions": [
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Select & Highlight",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
